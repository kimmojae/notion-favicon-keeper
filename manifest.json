{
  "manifest_version": 3,
  "name": "Favicon Keeper for Notion",
  "version": "1.0.0",
  "description": "Stops Notion from changing the browser tab icon to each page's emoji or image, so Notion tabs always look the same, including shared and public pages.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.notion.so/*",
        "https://*.notion.com/*",
        "https://*.notion.site/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "minimum_chrome_version": "111"
}
